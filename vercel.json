{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "theimpart.com"
        }
      ],
      "destination": "https://www.theimpart.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-:part.xml",
      "destination": "/api/sitemap?part=:part"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/articles/:path*",
      "destination": "/api/articles"
    },
    {
      "source": "/api/settings/:path*",
      "destination": "/api/settings"
    },
    {
      "source": "/article/:id",
      "destination": "/api/article-meta?id=:id"
    },
    {
      "source": "/((?!api/|uploads/|robots\\.txt|sitemap\\.xml|sitemap-[0-9]+\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
